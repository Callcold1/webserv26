🧠 Implementation Using getaddrinfo

#include <arpa/inet.h>
#include <netdb.h>
#include <cstring>
#include <cstdlib>
#include <stdexcept>

Listen_t::Listen_t(std::string ip_str, bool default_port, int port_num)
    : is_default(default_port), port(static_cast<uint16_t>(port_num))
{
    struct addrinfo hints;
    struct addrinfo* res = NULL;

    std::memset(&hints, 0, sizeof(hints));
    hints.ai_family = AF_INET;        // IPv4 only
    hints.ai_socktype = SOCK_STREAM;  // TCP
    hints.ai_flags = AI_NUMERICHOST;  // Only accept numeric IP (no DNS)

    // If ip_str is empty → treat as wildcard
    const char* node = NULL;
    if (!ip_str.empty())
        node = ip_str.c_str();

    int status = getaddrinfo(node, NULL, &hints, &res);
    if (status != 0)
        throw std::runtime_error(gai_strerror(status));

    struct sockaddr_in* addr =
        reinterpret_cast<struct sockaddr_in*>(res->ai_addr);

    this->ip = addr->sin_addr.s_addr;  // already in NETWORK byte order

    freeaddrinfo(res);
}

🔥 What This Handles Correctly
Case 1

listen 127.0.0.1:8080;

    ip_str = "127.0.0.1"

    ip becomes correct binary form

Case 2

listen 0.0.0.0:8080;

    ip_str = "0.0.0.0"

    ip = INADDR_ANY

Case 3

listen 8080;

If you pass "" as ip_str:

    node = NULL

    getaddrinfo with NULL + no AI_PASSIVE returns loopback by default

If you want proper wildcard behavior for missing IP:

Replace:

hints.ai_flags = AI_NUMERICHOST;

with:

hints.ai_flags = AI_PASSIVE;

And keep node = NULL.

Then it returns 0.0.0.0.
