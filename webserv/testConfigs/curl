# CURL WEB SERVER TEST COMMANDS

<!-- 1. Basic Request -->
curl http://localhost:8080

<!-- 2. Verbose Output (shows headers and connection info) -->
curl -v http://localhost:8080

<!-- 3. Fetch Only Headers (HEAD request) -->
curl -I http://localhost:8080

<!-- 4. Follow Redirects -->
curl -L http://localhost:8080

5. HTTP Method Tests
   <!-- GET -->
curl -X GET http://localhost:8080/api/test

<!-- POST -->
curl -X POST http://localhost:8080/api/test

<!-- PUT -->
curl -X PUT http://localhost:8080/api/test

<!-- DELETE -->
curl -X DELETE http://localhost:8080/api/test

<!-- PATCH -->
curl -X PATCH http://localhost:8080/api/test

<!-- OPTIONS -->
curl -X OPTIONS http://localhost:8080

<!-- 6. Send JSON Data -->
curl -X POST http://localhost:8080/api/test 
   -H "Content-Type: application/json" 
   -d '{"name":"test","value":123}'

<!-- 7. Send Form Data -->
curl -X POST http://localhost:8080/login 
   -d "username=test&password=secret"

<!-- 8. Upload File (multipart form) -->
curl -X POST http://localhost:8080/upload 
   -F "file=@test.txt"

<!-- 9. Custom Header Test -->
curl http://localhost:8080 
   -H "X-Test-Header: hello"

<!-- 10. Custom User-Agent -->
curl http://localhost:8080 
    -H "User-Agent: test-agent"

<!-- 11. Basic Authentication -->
curl -u username:password http://localhost:8080

<!-- 12. Bearer Token Authentication -->
curl http://localhost:8080/api 
    -H "Authorization: Bearer TOKEN_HERE"

<!-- 13. Send Cookie -->
curl http://localhost:8080 
    -H "Cookie: session=abc123"

<!-- 14. Save Cookies -->
curl -c cookies.txt http://localhost:8080

<!-- 15. Reuse Saved Cookies -->
curl -b cookies.txt http://localhost:8080

<!-- 16. Enable Compression -->
curl --compressed http://localhost:8080

<!-- 17. Timeout Test -->
curl --max-time 5 http://localhost:8080

<!-- 18. Force HTTP/1.1 -->
curl --http1.1 http://localhost:8080

<!-- 19. Force HTTP/2 -->
curl --http2 http://localhost:8080

<!-- 20. Ignore TLS Certificate Errors -->
curl -k https://localhost:8443

<!-- 21. Show TLS Handshake Details -->
curl -v https://localhost:8443

<!-- 22. Upload Binary File -->
curl -X POST http://localhost:8080/upload 
    --data-binary @largefile.bin

<!-- 23. Parallel Request Test (bash) -->
    for i in {1..50}; do curl -s http://localhost:8080 & done

<!-- 24. Show Only HTTP Status Code -->
curl -o /dev/null -s -w "%{http_code}\n" http://localhost:8080

<!-- 25. Show Timing Metrics -->
curl -o /dev/null -s -w "DNS: %{time_namelookup}\nConnect: %{time_connect}\nTTFB: %{time_starttransfer}\nTotal: %{time_total}\n" http://localhost:8080


